! Transformer part 4/7: one radiator panel (internal part of transformer-assembly; place it with ADD_COMPONENT ... FROM "tf-radiator").
! Part origin: center of the panel (X = 0, D = 0), underside at elevation 0.
GEA_VERSION 1
PRODUCT_NAME "Transformer radiator"
PARAM_PREFIX TRD_
TARGET PART

BEGIN_FORM
  BEGIN_GROUP "Radiator"
    USER_INPUT_PARAM TRD_Width  LENGTH 400 mm  MIN 150 MAX 800  LABEL "Radiator width (X)"
    USER_INPUT_PARAM TRD_Depth  LENGTH 220 mm  MIN 80  MAX 500  LABEL "Radiator depth (D)"
    USER_INPUT_PARAM TRD_Height LENGTH 1000 mm MIN 300 MAX 2800 LABEL "Radiator height"
  END_GROUP
END_FORM

BEGIN_BUILD
  DECLARE_REFERENCE body
  CREATE_FEATURE builder:Block
    FEATURE_IN "SizeX"  TRD_Width
    FEATURE_IN "SizeD"  TRD_Depth
    FEATURE_IN "Height" TRD_Height
    FEATURE_OUT body "Body"
  END_CREATE_FEATURE
  SET_REF_NAME body "TF_Radiator"
  SET_REF_ATTR body "ROLE" "RADIATOR"
  SET_APPEARANCE body "Grey"
  REGEN_MDL
END_BUILD
