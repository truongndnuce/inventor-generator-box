! Transformer part 7/7: one bushing (internal part of transformer-assembly; place it with ADD_COMPONENT ... FROM "tf-bushing").
! Part origin: axis of the bushing at X = 0, D = 0, underside of the turret at elevation 0.
GEA_VERSION 1
PRODUCT_NAME "Transformer bushing"
PARAM_PREFIX TBU_
TARGET PART

BEGIN_FORM
  BEGIN_GROUP "Bushing"
    USER_INPUT_PARAM TBU_Diameter     LENGTH 200 mm MIN 100 MAX 400  LABEL "Bushing diameter"
    USER_INPUT_PARAM TBU_Length       LENGTH 800 mm MIN 300 MAX 2000 LABEL "Bushing length"
    USER_INPUT_PARAM TBU_ShedCount    INTEGER 8     MIN 3   MAX 14   LABEL "Shed count"
    USER_INPUT_PARAM TBU_TurretHeight LENGTH 200 mm MIN 80  MAX 500  LABEL "Turret height"
  END_GROUP
END_FORM

BEGIN_BUILD
  DECLARE_REFERENCE body
  CREATE_FEATURE builder:Bushing
    FEATURE_IN "Diameter"     TBU_Diameter
    FEATURE_IN "Length"       TBU_Length
    FEATURE_IN "TurretHeight" TBU_TurretHeight
    FEATURE_IN "ShedCount"    TBU_ShedCount
    FEATURE_OUT body "Body"
  END_CREATE_FEATURE
  SET_REF_NAME body "TF_Bushing"
  SET_REF_ATTR body "ROLE" "BUSHING"
  SET_APPEARANCE body "Porcelain"
  REGEN_MDL
END_BUILD
