<UserControl x:Class="InventorAddin.Views.ScriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAFAFB" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Không thừa hưởng style ComboBoxItem của tab Box (binding vào preset) -->
        <Style TargetType="ComboBoxItem" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B6BCC6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="#D32F2F" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="ToolTip" Value="{Binding Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Một dòng thông báo: đỏ cho lỗi, cam cho cảnh báo, xám cho ghi chú -->
        <DataTemplate x:Key="MessageRow">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#6B7280" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#D32F2F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="#B45309" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- Một ô của form: DataContext là ScriptFieldViewModel -->
        <DataTemplate x:Key="FieldRow">
            <Grid Margin="0,2" Visibility="{Binding Visible, Converter={StaticResource BoolVis}}" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" MinWidth="70" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsText, Converter={StaticResource BoolVis}}" />
                <CheckBox Grid.Column="1" IsChecked="{Binding Checked}" VerticalAlignment="Center"
                          Visibility="{Binding IsCheckbox, Converter={StaticResource BoolVis}}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}"
                          Visibility="{Binding IsRadio, Converter={StaticResource BoolVis}}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" />
                <TextBlock Grid.Column="3" Text="{Binding Range}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="10" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- File -->
        <WrapPanel Grid.Row="0">
            <Button Style="{StaticResource ActionButton}" Content="Open…" Command="{Binding OpenCommand}" ToolTip="Open a .gea script file" />
            <Button Style="{StaticResource ActionButton}" Content="New" Command="{Binding NewCommand}" />
            <Button Style="{StaticResource ActionButton}" Content="Save" Command="{Binding SaveCommand}" />
            <Button Style="{StaticResource ActionButton}" Content="Save as…" Command="{Binding SaveAsCommand}" />
            <Button Style="{StaticResource ActionButton}" Content="Reload" Command="{Binding ReloadCommand}" ToolTip="Read the script file from disk again" />
            <Button Style="{StaticResource ActionButton}" Content="Edit externally" Command="{Binding EditExternallyCommand}"
                    ToolTip="Open the file in your editor; saving it reloads the script here" />
        </WrapPanel>
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Template" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" />
            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Margin="4,0,0,0" Content="Open template" Command="{Binding OpenTemplateCommand}" />
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FileTitle}" Foreground="#6B7280" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScriptPath}" />
            <CheckBox Content="Apply automatically when the script file is saved" IsChecked="{Binding AutoApply}" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="3" Padding="4">
            <TabItem Header="Form">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Header="{Binding Title}" Margin="0,0,0,6" Padding="4"
                                              Visibility="{Binding Visible, Converter={StaticResource BoolVis}}">
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FieldRow}" />
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding FormMessages}" ItemTemplate="{StaticResource MessageRow}" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Script">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="Editor" Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Grid.Row="1" Text="{Binding DiagnosticsHeader}" Margin="0,4,0,2" FontWeight="SemiBold" />
                    <ListBox Grid.Row="2" x:Name="Problems" ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource MessageRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnProblemDoubleClick"
                             ToolTip="Double-click a problem to go to its line" />
                </Grid>
            </TabItem>
            <TabItem Header="Log">
                <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11" />
            </TabItem>
        </TabControl>

        <!-- Hành động + trạng thái -->
        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <WrapPanel>
                <Button Style="{StaticResource ActionButton}" Content="Apply" Command="{Binding ApplyCommand}" FontWeight="SemiBold"
                        ToolTip="Save the script, then rebuild the model from it (one undo step)" />
                <Button Style="{StaticResource ActionButton}" Content="Defaults" Command="{Binding DefaultsCommand}" />
                <Button Style="{StaticResource ActionButton}" Content="Load from model" Command="{Binding LoadFromModelCommand}"
                        ToolTip="Load the script and values stored in the active Part" />
                <Button Style="{StaticResource ActionButton}" Content="Remove model" Command="{Binding RemoveCommand}" />
                <Button Style="{StaticResource ActionButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#374151" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#D32F2F" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
