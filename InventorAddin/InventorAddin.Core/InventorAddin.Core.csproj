<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The shared library of every Cadflow add-in: the .gea interpreter, the Inventor services, the web worker, the CadflowAddIn base class,
      the parameter definitions (Models) that the server also links in. It is not an add-in itself; each add-in lives in Addins\<Name>.
    -->
    <PropertyGroup>
        <AssemblyName>InventorAddin.Core</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Sample .gea scripts: they travel through the ProjectReference into the output folder of each add-in (the web worker uses Scripts\*.gea to build products). -->
        <None Include="Scripts\*.gea">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- Component libraries for INCLUDE lib:<name>: Scripts\lib\*.gea next to the add-in. -->
        <None Include="Scripts\lib\*.gea">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="addin.template">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
