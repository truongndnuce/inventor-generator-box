<UserControl x:Class="InventorAddin.Views.AddInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:InventorAddin.Views"
             MinWidth="260" MinHeight="300"
             Background="#FAFAFB" Foreground="#1F2937" FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B6BCC6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="#D32F2F" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="ToolTip" Value="{Binding Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Một dòng thông số: DataContext là ParamViewModel -->
        <DataTemplate x:Key="ParamRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="50" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" />
                <Slider Grid.Column="3" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        Value="{Binding SliderValue}" VerticalAlignment="Center" Margin="4,0,0,0"
                        IsMoveToPointEnabled="True" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Padding="0" BorderThickness="0">
    <!-- Tab 1: hộp viết cứng (BoxParams). Tab 2: dựng theo script .gea kiểu SmartAssembly. -->
    <TabItem Header="Box">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preset -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedPreset}" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Style="{StaticResource ActionButton}" Content="Save as…" Command="{Binding SavePresetCommand}" />
            <Button Style="{StaticResource ActionButton}" Content="Overwrite" Command="{Binding OverwritePresetCommand}" />
            <Button Style="{StaticResource ActionButton}" Content="Delete" Command="{Binding DeletePresetCommand}" />
        </StackPanel>

        <!-- Canvas xem trước -->
        <Border Grid.Row="2" BorderBrush="#B6BCC6" BorderThickness="1" Margin="0,0,0,2" ClipToBounds="True">
            <TabControl Padding="0" BorderThickness="0">
                <TabItem Header="Section">
                    <views:PreviewControl Scene="{Binding SectionScene}" Highlight="{Binding FocusedParam}"
                                          ErrorParams="{Binding ErrorParams}" />
                </TabItem>
                <TabItem Header="Plan">
                    <views:PreviewControl Scene="{Binding PlanScene}" Highlight="{Binding FocusedParam}"
                                          ErrorParams="{Binding ErrorParams}" />
                </TabItem>
            </TabControl>
        </Border>

        <!-- Form thông số: dựng từ bảng ParameterDef -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,6">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding Title}" Margin="0,0,0,6" Padding="4">
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ParamRow}" />
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Hành động + trạng thái -->
        <StackPanel Grid.Row="4">
            <WrapPanel Margin="0,0,0,6">
                <Button Style="{StaticResource ActionButton}" Content="Create" Command="{Binding CreateCommand}" FontWeight="SemiBold" />
                <Button Style="{StaticResource ActionButton}" Content="Apply" Command="{Binding ApplyCommand}" FontWeight="SemiBold" />
                <Button Style="{StaticResource ActionButton}" Content="Revert" Command="{Binding RevertCommand}" />
                <Button Style="{StaticResource ActionButton}" Content="Defaults" Command="{Binding DefaultCommand}" />
                <Button Style="{StaticResource ActionButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#374151" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#D32F2F" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="The preview is only a schematic; the model changes only when you click Apply."
                       Foreground="#9CA3AF" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
    </TabItem>
    <TabItem Header="Script (.gea)">
        <views:ScriptPanel x:Name="ScriptView" />
    </TabItem>
    </TabControl>
</UserControl>
