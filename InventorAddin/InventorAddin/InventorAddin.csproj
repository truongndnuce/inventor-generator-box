<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>InventorAddin</RootNamespace>
        <AssemblyName>InventorAddin</AssemblyName>
        <PlatformTarget>x64</PlatformTarget>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Version>0.1.0</Version>

        <!-- Thư mục cài Inventor 2027. Ghi đè bằng -p:InventorDir=... nếu cài ở nơi khác. -->
        <InventorDir Condition="'$(InventorDir)' == ''">C:\Program Files\Autodesk\Inventor 2027\</InventorDir>
        <!-- Đặt false để không tự ghi file .addin vào %AppData% sau khi build. -->
        <DeployAddin Condition="'$(DeployAddin)' == ''">true</DeployAddin>
        <InventorAddinsDir>$(AppData)\Autodesk\Inventor 2027\Addins\</InventorAddinsDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Private=false: dùng bản Interop do Inventor đã nạp, không copy vào thư mục output. -->
        <Reference Include="Autodesk.Inventor.Interop">
            <HintPath>$(InventorDir)Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
            <Private>False</Private>
            <EmbedInteropTypes>False</EmbedInteropTypes>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="presets.default.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="InventorAddin.addin.template">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Sinh file .addin trỏ tới DLL vừa build, đặt vào thư mục Addins của người dùng (regfree, không cần quyền admin). -->
    <Target Name="DeployAddinManifest" AfterTargets="Build" Condition="'$(DeployAddin)' == 'true' And '$(OS)' == 'Windows_NT'">
        <PropertyGroup>
            <AddinTemplateText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\InventorAddin.addin.template'))</AddinTemplateText>
            <AddinText>$(AddinTemplateText.Replace('$ASSEMBLY$', '$(TargetPath)'))</AddinText>
        </PropertyGroup>
        <MakeDir Directories="$(InventorAddinsDir)" />
        <WriteLinesToFile File="$(InventorAddinsDir)InventorBoxAddin.addin" Lines="$(AddinText)" Overwrite="true" Encoding="UTF-8" />
        <Message Importance="high" Text="Đã ghi $(InventorAddinsDir)InventorBoxAddin.addin" />
    </Target>

</Project>
