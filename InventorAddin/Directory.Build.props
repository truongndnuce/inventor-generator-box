<Project>

    <!-- Shared settings for Core and every add-in of the Cadflow suite. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>InventorAddin</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Version>0.2.0</Version>

        <!-- The Inventor 2027 install folder. Override with -p:InventorDir=... if it is installed elsewhere. -->
        <InventorDir Condition="'$(InventorDir)' == ''">C:\Program Files\Autodesk\Inventor 2027\</InventorDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Private=false: use the Interop that Inventor has already loaded, do not copy it into the output folder. -->
        <Reference Include="Autodesk.Inventor.Interop">
            <HintPath>$(InventorDir)Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
            <Private>False</Private>
            <EmbedInteropTypes>False</EmbedInteropTypes>
        </Reference>
    </ItemGroup>

</Project>
