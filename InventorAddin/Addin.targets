<Project>

    <!--
      Shared by the add-in csproj files (imported at the end of the csproj). Each csproj declares:
        AddinClassId (a GUID, equal to the [Guid] of the add-in class), AddinDisplayName, AddinDescription, AddinFileName.
      After the build, generates the .addin file that points to the DLL just built and puts it in the user's Addins folder (regfree, no admin rights needed).
      Set -p:DeployAddin=false to not write into %AppData%.
    -->
    <PropertyGroup>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <DeployAddin Condition="'$(DeployAddin)' == ''">true</DeployAddin>
        <InventorAddinsDir Condition="'$(InventorAddinsDir)' == ''">$(AppData)\Autodesk\Inventor 2027\Addins\</InventorAddinsDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)InventorAddin.Core\InventorAddin.Core.csproj" />
    </ItemGroup>

    <Target Name="DeployAddinManifest" AfterTargets="Build" Condition="'$(DeployAddin)' == 'true' And '$(OS)' == 'Windows_NT'">
        <PropertyGroup>
            <AddinTemplateText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)InventorAddin.Core\addin.template'))</AddinTemplateText>
            <AddinText>$(AddinTemplateText.Replace('$ASSEMBLY$', '$(TargetPath)').Replace('$CLASSID$', '$(AddinClassId)').Replace('$NAME$', '$(AddinDisplayName)').Replace('$DESCRIPTION$', '$(AddinDescription)'))</AddinText>
        </PropertyGroup>
        <MakeDir Directories="$(InventorAddinsDir)" />
        <WriteLinesToFile File="$(InventorAddinsDir)$(AddinFileName)" Lines="$(AddinText)" Overwrite="true" Encoding="UTF-8" />
        <Message Importance="high" Text="Wrote $(InventorAddinsDir)$(AddinFileName)" />
    </Target>

</Project>
