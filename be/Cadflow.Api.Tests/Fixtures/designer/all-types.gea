! ============================================================================
! Generated by the Product Designer of CAD Automation.
! Open this file in the Designer to change it. Text edited by hand is detected, and the Designer
! asks before it drops those edits.
! ============================================================================
GEA_VERSION 1
PRODUCT_NAME "Axial fan"
PARAM_PREFIX FN_
TARGET PART

BEGIN_FORM

  ! Parameters: the input fields of the order form, in groups. A field inside IF ... END_IF is shown only while the condition is true.
  BEGIN_GROUP "Casing"
    USER_INPUT_PARAM FN_Diameter LENGTH 1200 mm MIN 400 MAX 3000 STEP 50 REQUIRED LABEL "Casing diameter" TOOLTIP "Inner diameter of the casing"
    USER_INPUT_PARAM FN_Length LENGTH 0.4 m MIN 0.1 MAX 2 LABEL "Casing length"
    USER_INPUT_PARAM FN_Pitch ANGLE 30 deg MIN 0 MAX 90 LABEL "Blade pitch"
  END_GROUP

  BEGIN_GROUP "Rotor and options"
    USER_INPUT_PARAM FN_Blades INTEGER 6 MIN 2 MAX 24 REQUIRED LABEL "Blade count"
    USER_INPUT_PARAM FN_Ratio DOUBLE 0.5 MIN 0.1 MAX 0.9 LABEL "Hub ratio"
    USER_INPUT_PARAM FN_Tag STRING "Fan \"A\"" LABEL "Tag" TOOLTIP "Shown on the drawing"
    CHECKBOX_PARAM FN_Guard TRUE LABEL "With guard"
    IF FN_Guard
      USER_INPUT_PARAM FN_GuardGap LENGTH 20 mm MIN 5 MAX 60 LABEL "Guard gap"
    END_IF
    RADIOBUTTON_PARAM FN_Mount "Floor" "Wall" "Ceiling" LABEL "Mounting" DEFAULT "Wall"
    RADIOBUTTON_PARAM FN_Drive "Direct" "Belt" LABEL "Drive"
  END_GROUP

  ! Variables: values computed from the parameters, for use in the rules below (a variable is valid only in this block).
  DECLARE_VARIABLE LENGTH radius
  radius = FN_Diameter / 2

  ! Rules: each ASSERT must hold, otherwise the order form shows its message (a rule marked WARN only warns).
  ASSERT FN_Length > radius / 4 "Casing length must exceed a quarter of the radius."
  ASSERT FN_Blades * 10 <= 200 "That many blades is unusual." WARN

END_FORM

BEGIN_BUILD

  ! Build steps (text).
  REGEN_MDL

END_BUILD
